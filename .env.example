# tvtracker-mcp — конфигурация (pydantic-settings, префикс TVTRACKER_)
# Скопируй в .env: cp .env.example .env
# TVmaze не требует API-ключа — секретов здесь нет by design.

# --- Хранилище ---
# Путь к SQLite-базе. Берётся ТОЛЬКО отсюда, пользовательский ввод в путь не попадает.
TVTRACKER_DB_PATH=data/tvtracker.db

# --- Источник данных ---
TVTRACKER_TVMAZE_BASE_URL=https://api.tvmaze.com
TVTRACKER_HTTP_TIMEOUT=10.0
# Лимит TVmaze: ~20 запросов / 10 сек на IP. Держим запас.
TVTRACKER_RATE_LIMIT_PER_SECOND=1.8
TVTRACKER_MAX_RETRIES=3
TVTRACKER_BACKOFF_BASE=0.5

# --- Логирование ---
# DEBUG | INFO | WARNING | ERROR. Весь вывод идёт в stderr: stdout занят MCP-протоколом.
TVTRACKER_LOG_LEVEL=INFO
# json — для прод/анализа, console — читаемый вывод при разработке.
TVTRACKER_LOG_FORMAT=console
# Пустое значение = писать только в stderr.
TVTRACKER_LOG_FILE=

# --- Бюджет контекста ---
TVTRACKER_SUMMARY_MAX_CHARS=200
TVTRACKER_DEFAULT_LIMIT=8
